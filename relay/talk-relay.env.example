# /etc/omacctv-talk-relay.env (root, mode 600): one RTSP URL per camera with a speaker.
# The name after TALK_URL_ is the Frigate camera name with - replaced by _.
TALK_URL_front_door=rtsp://admin:PASSWORD@192.168.1.20:554/h264Preview_01_main
#TALK_URL_garage=rtsp://admin:PASSWORD@192.168.1.21:554/h264Preview_01_main

# Optional: a camera whose talk goes to this machine's own speaker (aplay), e.g. a USB webcam.
#TALK_LOCAL=desk-webcam
#TALK_ALSA=default
#TALK_PORT=8557
